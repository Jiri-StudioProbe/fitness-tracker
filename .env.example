# Copy this to .env.production.local (gitignored — see *.local in
# .gitignore) and fill in the values from your real Firebase project's
# web app config (Project settings → General → Your apps → SDK setup
# and configuration → Config). These are NOT secrets — Firebase web
# config is meant to be public; real access control is enforced by
# firestore.rules. Leaving these unset (the default for local dev)
# makes the app talk to the Firebase Local Emulator Suite instead.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=

# Optional: pin sign-in to exactly this email (client-side UX guard —
# the real enforcement is in firestore.rules).
VITE_ALLOWED_EMAIL=

# Set to "false" to force real Firebase even when running `vite dev`.
# Otherwise dev always uses the emulators.
VITE_USE_EMULATORS=
