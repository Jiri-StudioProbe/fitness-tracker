rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can only read/write their own subtree. Nobody
    // else can get a uid under here in the first place unless they
    // receive your magic sign-in link (and the app's client-side check
    // in cloud/auth.js already refuses to send one to any email but
    // yours), but this is the real enforcement — not the client check.
    //
    // Optional extra pin once you know your real account email: add
    //   && request.auth.token.email == "you@example.com"
    // to the condition below.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
